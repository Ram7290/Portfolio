# ------------------------------------------------------------------
# Database (MongoDB Atlas free tier)
# Get a connection string: https://www.mongodb.com/cloud/atlas
# ------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=portfolio

# ------------------------------------------------------------------
# Auth.js (admin authentication)
# Generate with: openssl rand -base64 32   (or: npx auth secret)
# ------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Initial admin account (used by `npm run seed` / first login; never commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Cloudinary (profile picture + project thumbnails only, free tier)
# https://console.cloudinary.com
# Option A — separate values (from Dashboard → Product Environment Credentials):
# ------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option B — the combined URL the dashboard shows (alternative to A):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ------------------------------------------------------------------
# Phone alerts for new contact messages — each channel is optional and
# turns on only when its values are set. Test from Admin → Messages.
# ------------------------------------------------------------------

# Telegram (free, recommended)
# 1. In Telegram, message @BotFather → /newbot → copy the token it gives you
# 2. Open your new bot and send it any message (e.g. "hi")
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#    "chat":{"id": ...} — that number is your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email backup via Resend (free: 3,000/month) — https://resend.com/api-keys
# Without a verified domain, Resend only delivers to your Resend sign-up
# email, so use that address for NOTIFY_EMAIL_TO.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Optional, only after verifying a domain in Resend:
# NOTIFY_EMAIL_FROM=Portfolio <alerts@yourdomain.com>

# ------------------------------------------------------------------
# WhatsApp alert for new contact messages (optional, free via CallMeBot)
# 1. Save the CallMeBot number listed at
#    https://www.callmebot.com/blog/free-api-whatsapp-messages/ in your contacts
# 2. WhatsApp it: I allow callmebot to send me messages
# 3. Paste the API key it replies with below. Phone in international format,
#    e.g. +919876543210
# ------------------------------------------------------------------
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ------------------------------------------------------------------
# Public site URL (SEO metadata, sitemap, Open Graph)
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
